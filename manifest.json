{
  "manifest_version": 3,
  "name": "Don't Scroll",
  "version": "0.1.0",
  "description": "Adds a small pause before opening distracting websites.",
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Don't Scroll"
  }
}
