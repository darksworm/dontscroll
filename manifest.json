{
  "manifest_version": 3,
  "name": "Don't Scroll",
  "version": "0.1.0",
  "description": "Adds a small pause before opening distracting websites.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.reddit.com/*", "*://reddit.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.reddit.com/*", "*://reddit.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Don't Scroll"
  }
}
